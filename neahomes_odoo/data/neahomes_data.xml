<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <record id="seq_neahomes_cotizacion" model="ir.sequence">
        <field name="name">Cotización NeaHomes</field>
        <field name="code">neahomes.cotizacion</field>
        <field name="prefix">NH</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_neahomes_ticket" model="ir.sequence">
        <field name="name">Ticket NeaHomes</field>
        <field name="code">neahomes.ticket</field>
        <field name="prefix">TK</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="param_ci_company" model="neahomes.parametro">
        <field name="name">ci_company</field>
        <field name="valor">1</field>
    </record>
    <record id="param_web_url" model="neahomes.parametro">
        <field name="name">web_url</field>
        <field name="valor">https://neahomes.vercel.app</field>
    </record>
    <record id="param_instagram_url" model="neahomes.parametro">
        <field name="name">instagram_url</field>
        <field name="valor">https://www.instagram.com/</field>
    </record>
    <!-- Datos del responsable para la política de cookies de la web -->
    <record id="param_legal_company" model="neahomes.parametro">
        <field name="name">legal_company</field>
        <field name="valor">NEA HOMES EXPERIENCE, S.L.</field>
    </record>
    <record id="param_legal_nif" model="neahomes.parametro">
        <field name="name">legal_nif</field>
        <field name="valor"></field>
    </record>
    <record id="param_legal_address" model="neahomes.parametro">
        <field name="name">legal_address</field>
        <field name="valor"></field>
    </record>
    <record id="param_legal_email" model="neahomes.parametro">
        <field name="name">legal_email</field>
        <field name="valor"></field>
    </record>
    <record id="param_api_key" model="neahomes.parametro">
        <field name="name">api_key</field>
        <field name="valor"></field>
    </record>

</odoo>
