    <!-- Menús: sequence 21 lo coloca justo después de Contactos (20) -->
    <menuitem id="menu_neahomes_root"
              name="NeaHomes"
              sequence="21"
              web_icon="neahomes_odoo,static/description/icon.png"/>

    <menuitem id="menu_neahomes_tamano"
              name="Tamaño"
              parent="menu_neahomes_root"
              action="action_neahomes_tamano"
              sequence="10"/>
    <menuitem id="menu_neahomes_cubierta"
