<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Cubierta -->
    <record id="view_neahomes_cubierta_tree" model="ir.ui.view">
        <field name="name">neahomes.cubierta.tree</field>
        <field name="model">neahomes.cubierta</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="forma"/>
                <field name="price"/>
            </tree>
        </field>
    </record>

    <record id="view_neahomes_cubierta_form" model="ir.ui.view">
        <field name="name">neahomes.cubierta.form</field>
        <field name="model">neahomes.cubierta</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="forma"/>
                        <field name="price"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_neahomes_cubierta" model="ir.actions.act_window">
        <field name="name">Cubierta</field>
        <field name="res_model">neahomes.cubierta</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Acabados -->
    <record id="view_neahomes_acabado_tree" model="ir.ui.view">
        <field name="name">neahomes.acabado.tree</field>
        <field name="model">neahomes.acabado</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color"/>
                <field name="price"/>
            </tree>
        </field>
    </record>

    <record id="view_neahomes_acabado_form" model="ir.ui.view">
        <field name="name">neahomes.acabado.form</field>
        <field name="model">neahomes.acabado</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color"/>
                        <field name="price"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_neahomes_acabado" model="ir.actions.act_window">
        <field name="name">Acabados</field>
        <field name="res_model">neahomes.acabado</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Modelos -->
    <record id="view_neahomes_modelo_tree" model="ir.ui.view">
        <field name="name">neahomes.modelo.tree</field>
        <field name="model">neahomes.modelo</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="m2"/>
                <field name="description"/>
                <field name="price"/>
            </tree>
        </field>
    </record>

    <record id="view_neahomes_modelo_form" model="ir.ui.view">
        <field name="name">neahomes.modelo.form</field>
        <field name="model">neahomes.modelo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="m2"/>
                        <field name="description"/>
                        <field name="image" widget="image" options="{'size': [360, 180]}"/>
                        <field name="price"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <separator string="Distribución"/>
                    <field name="distribucion_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="numero"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_neahomes_modelo" model="ir.actions.act_window">
        <field name="name">Modelos</field>
        <field name="res_model">neahomes.modelo</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Cotizaciones -->
    <record id="view_neahomes_cotizacion_tree" model="ir.ui.view">
        <field name="name">neahomes.cotizacion.tree</field>
        <field name="model">neahomes.cotizacion</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="create_date" string="Fecha"/>
                <field name="partner_id"/>
                <field name="comercial_id"/>
                <field name="modelo_id"/>
                <field name="cubierta_id"/>
                <field name="acabado_id"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge" decoration-info="state == 'nuevo'" decoration-warning="state == 'estudio'" decoration-success="state == 'aceptada'" decoration-danger="state == 'rechazada'"/>
                <field name="stage_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_neahomes_cotizacion_form" model="ir.ui.view">
        <field name="name">neahomes.cotizacion.form</field>
        <field name="model">neahomes.cotizacion</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_estudio" type="object" string="Pasar a estudio"
                            class="btn-primary" invisible="state != 'nuevo'"/>
                    <button name="action_aceptar" type="object" string="Aceptar"
                            class="btn-primary" invisible="state != 'estudio'"/>
                    <button name="action_rechazar" type="object" string="Rechazar"
                            invisible="state != 'estudio'"/>
                    <button name="action_nuevo" type="object" string="Volver a nuevo"
                            invisible="state == 'nuevo'"/>
                    <button name="action_create_lead" type="object" string="Crear oportunidad"
                            invisible="lead_id"/>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="comercial_id"/>
                            <field name="lead_id"/>
                            <field name="stage_id" invisible="not lead_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="create_date" string="Fecha"/>
                        </group>
                    </group>
                    <group string="Configuración">
                        <group>
                            <field name="modelo_id"/>
                            <field name="cubierta_id"/>
                            <field name="acabado_id"/>
                        </group>
                        <group>
                            <field name="price_modelo"/>
                            <field name="price_cubierta"/>
                            <field name="price_acabado"/>
                            <field name="amount_total" class="fw-bold"/>
                        </group>
                    </group>
                    <group string="Condiciones de venta aceptadas" invisible="not aceptacion_ids">
                        <field name="aceptacion_ids" nolabel="1" colspan="2" readonly="1">
                            <tree>
                                <field name="date"/>
                                <field name="condicion_name"/>
                                <field name="ip"/>
                            </tree>
                        </field>
                    </group>
                    <group string="Distribución" invisible="not distribucion_ids">
                        <field name="distribucion_ids" nolabel="1" colspan="2" readonly="1">
                            <tree>
                                <field name="name"/>
                                <field name="cantidad"/>
                            </tree>
                        </field>
                    </group>
                    <field name="ticket_ids" readonly="1" invisible="not ticket_ids">
                        <tree>
                            <field name="ref"/>
                            <field name="create_date" string="Fecha"/>
                            <field name="name"/>
                            <field name="state" widget="badge" decoration-info="state == 'nuevo'" decoration-warning="state == 'trabajando'" decoration-success="state == 'resuelto'"/>
                        </tree>
                    </field>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_neahomes_cotizacion" model="ir.actions.act_window">
        <field name="name">Cotizaciones</field>
        <field name="res_model">neahomes.cotizacion</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Distribución -->
    <record id="view_neahomes_distribucion_tree" model="ir.ui.view">
        <field name="name">neahomes.distribucion.tree</field>
        <field name="model">neahomes.distribucion</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="numero"/>
                <field name="modelo_id"/>
            </tree>
        </field>
    </record>

    <record id="view_neahomes_distribucion_search" model="ir.ui.view">
        <field name="name">neahomes.distribucion.search</field>
        <field name="model">neahomes.distribucion</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="modelo_id"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_modelo" string="Modelo" context="{'group_by': 'modelo_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_neahomes_distribucion" model="ir.actions.act_window">
        <field name="name">Distribución</field>
        <field name="res_model">neahomes.distribucion</field>
        <field name="view_mode">tree</field>
        <field name="context">{'search_default_group_modelo': 1}</field>
    </record>

    <!-- Condiciones de venta -->
    <record id="view_neahomes_condicion_tree" model="ir.ui.view">
        <field name="name">neahomes.condicion.tree</field>
        <field name="model">neahomes.condicion</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date"/>
                <field name="name"/>
                <field name="aceptacion_count"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_neahomes_condicion_form" model="ir.ui.view">
        <field name="name">neahomes.condicion.form</field>
        <field name="model">neahomes.condicion</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Título"/></h1>
                    </div>
                    <group>
                        <field name="date"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <div class="text-muted mb-3">
                        La web muestra las condiciones activas más recientes y exige aceptarlas para guardar una cotización.
                        Para cambiarlas sin perder el historial, crea unas nuevas y archiva las anteriores.
                    </div>
                    <field name="body"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_neahomes_condicion" model="ir.actions.act_window">
        <field name="name">Condiciones</field>
        <field name="res_model">neahomes.condicion</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <record id="view_neahomes_aceptacion_tree" model="ir.ui.view">
        <field name="name">neahomes.condicion.aceptacion.tree</field>
        <field name="model">neahomes.condicion.aceptacion</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false">
                <field name="date"/>
                <field name="partner_id"/>
                <field name="cotizacion_id"/>
                <field name="condicion_name"/>
                <field name="ip" optional="show"/>
                <field name="user_agent" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_neahomes_aceptacion_form" model="ir.ui.view">
        <field name="name">neahomes.condicion.aceptacion.form</field>
        <field name="model">neahomes.condicion.aceptacion</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="partner_id"/>
                            <field name="cotizacion_id"/>
                        </group>
                        <group>
                            <field name="condicion_id"/>
                            <field name="ip"/>
                            <field name="user_agent"/>
                        </group>
                    </group>
                    <separator string="Texto aceptado"/>
                    <field name="condicion_name" class="fw-bold"/>
                    <field name="condicion_body"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_neahomes_aceptacion_search" model="ir.ui.view">
        <field name="name">neahomes.condicion.aceptacion.search</field>
        <field name="model">neahomes.condicion.aceptacion</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="cotizacion_id"/>
                <field name="condicion_id"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_condicion" string="Condiciones" context="{'group_by': 'condicion_id'}"/>
                    <filter name="group_partner" string="Cliente" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_neahomes_aceptacion" model="ir.actions.act_window">
        <field name="name">Aceptaciones</field>
        <field name="res_model">neahomes.condicion.aceptacion</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Tickets -->
    <record id="view_neahomes_ticket_tree" model="ir.ui.view">
        <field name="name">neahomes.ticket.tree</field>
        <field name="model">neahomes.ticket</field>
        <field name="arch" type="xml">
            <tree>
                <field name="ref"/>
                <field name="create_date" string="Fecha"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="cotizacion_id"/>
                <field name="state" widget="badge" decoration-info="state == 'nuevo'" decoration-warning="state == 'trabajando'" decoration-success="state == 'resuelto'"/>
            </tree>
        </field>
    </record>

    <record id="view_neahomes_ticket_kanban" model="ir.ui.view">
        <field name="name">neahomes.ticket.kanban</field>
        <field name="model">neahomes.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" records_draggable="1">
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_title"><strong><field name="name"/></strong></div>
                            <div class="text-muted"><field name="ref"/> · <field name="partner_id"/></div>
                            <div t-if="record.cotizacion_id.raw_value"><field name="cotizacion_id"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_neahomes_ticket_form" model="ir.ui.view">
        <field name="name">neahomes.ticket.form</field>
        <field name="model">neahomes.ticket</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_trabajando" type="object" string="Empezar a trabajar"
                            class="btn-primary" invisible="state != 'nuevo'"/>
                    <button name="action_resuelto" type="object" string="Marcar resuelto"
                            class="btn-primary" invisible="state != 'trabajando'"/>
                    <button name="action_nuevo" type="object" string="Reabrir"
                            invisible="state != 'resuelto'"/>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <div class="text-muted"><field name="ref"/></div>
                        <h1><field name="name" placeholder="Título"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="cotizacion_id"/>
                        </group>
                        <group>
                            <field name="create_date" string="Fecha"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Texto"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_neahomes_ticket_search" model="ir.ui.view">
        <field name="name">neahomes.ticket.search</field>
        <field name="model">neahomes.ticket</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="ref"/>
                <field name="partner_id"/>
                <field name="cotizacion_id"/>
                <filter name="abiertos" string="Abiertos" domain="[('state', '!=', 'resuelto')]"/>
                <filter name="resueltos" string="Resueltos" domain="[('state', '=', 'resuelto')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="Cliente" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_neahomes_ticket" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">neahomes.ticket</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <!-- Web: carrusel -->
    <record id="view_neahomes_slide_tree" model="ir.ui.view">
        <field name="name">neahomes.slide.tree</field>
        <field name="model">neahomes.slide</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="image" widget="image" options="{'size': [96, 54]}"/>
                <field name="name"/>
                <field name="subtitle"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_neahomes_slide_form" model="ir.ui.view">
        <field name="name">neahomes.slide.form</field>
        <field name="model">neahomes.slide</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image" widget="image" options="{'size': [480, 270]}"/>
                    <group>
                        <group string="Textos">
                            <field name="name"/>
                            <field name="subtitle"/>
                            <field name="text_theme" widget="radio"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Botones">
                            <field name="button1_text"/>
                            <field name="button1_url"/>
                            <field name="button2_text"/>
                            <field name="button2_url"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Deja vacío el texto de un botón para ocultarlo. El carrusel muestra como máximo 3 slides activos.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_neahomes_slide" model="ir.actions.act_window">
        <field name="name">Carrusel</field>
        <field name="res_model">neahomes.slide</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <!-- Contactos: clientes registrados y comerciales -->
    <record id="action_neahomes_clientes" model="ir.actions.act_window">
        <field name="name">Clientes</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('nea_user', '!=', False)]</field>
        <field name="context">{'default_nea_portal': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay clientes registrados</p>
            <p>Los clientes aparecen aquí cuando se registran desde la web o les asignas usuario NeaHome.</p>
        </field>
    </record>

    <record id="action_neahomes_comerciales" model="ir.actions.act_window">
        <field name="name">Comerciales</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('nea_comercial', '=', True)]</field>
        <field name="context">{'default_nea_comercial': True, 'default_nea_portal': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aún no hay comerciales</p>
            <p>Marca el check «Comercial» en la pestaña NeaHome de un contacto. Recibirá cotizaciones por rotación y podrá entrar al CRM de la web con su usuario NeaHome.</p>
        </field>
    </record>

    <!-- Formulario de contacto -->
    <record id="view_neahomes_contacto_tree" model="ir.ui.view">
        <field name="name">neahomes.contacto.tree</field>
        <field name="model">neahomes.contacto</field>
        <field name="arch" type="xml">
            <tree>
                <field name="create_date" string="Fecha"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="message"/>
            </tree>
        </field>
    </record>

    <record id="view_neahomes_contacto_form" model="ir.ui.view">
        <field name="name">neahomes.contacto.form</field>
        <field name="model">neahomes.contacto</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                        </group>
                        <group>
                            <field name="create_date" string="Fecha"/>
                        </group>
                    </group>
                    <field name="message" placeholder="Texto"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_neahomes_contacto" model="ir.actions.act_window">
        <field name="name">Formulario de contacto</field>
        <field name="res_model">neahomes.contacto</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Parámetros -->
    <record id="view_neahomes_parametro_tree" model="ir.ui.view">
        <field name="name">neahomes.parametro.tree</field>
        <field name="model">neahomes.parametro</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="valor"/>
            </tree>
        </field>
    </record>

    <record id="action_neahomes_parametro" model="ir.actions.act_window">
        <field name="name">Parámetros</field>
        <field name="res_model">neahomes.parametro</field>
        <field name="view_mode">tree</field>
    </record>

    <!-- Pestaña NeaHome en el contacto -->
    <record id="view_partner_form_neahome" model="ir.ui.view">
        <field name="name">res.partner.form.neahome</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="NeaHome" name="neahome">
                    <group>
                        <group string="Acceso web">
                            <field name="nea_portal" widget="boolean_toggle"/>
                            <field name="nea_comercial" widget="boolean_toggle"/>
                            <field name="nea_user"/>
                            <field name="nea_password" password="True"
                                   readonly="nea_user and not nea_portal"/>
                        </group>
                    </group>
                    <field name="nea_cotizacion_ids" readonly="1">
                        <tree>
                            <field name="name"/>
                            <field name="create_date" string="Fecha"/>
                            <field name="modelo_id"/>
                            <field name="cubierta_id"/>
                            <field name="acabado_id"/>
                            <field name="comercial_id"/>
                            <field name="amount_total"/>
                            <field name="state" widget="badge" decoration-info="state == 'nuevo'" decoration-warning="state == 'estudio'" decoration-success="state == 'aceptada'" decoration-danger="state == 'rechazada'"/>
                        </tree>
                    </field>
                    <separator string="Tickets"/>
                    <field name="nea_ticket_ids" readonly="1">
                        <tree>
                            <field name="ref"/>
                            <field name="create_date" string="Fecha"/>
                            <field name="name"/>
                            <field name="cotizacion_id"/>
                            <field name="state" widget="badge" decoration-info="state == 'nuevo'" decoration-warning="state == 'trabajando'" decoration-success="state == 'resuelto'"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

