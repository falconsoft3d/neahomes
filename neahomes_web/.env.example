# URL del Odoo con el módulo neahomes_odoo instalado (solo se usa en el servidor de Next.js)
ODOO_URL=http://localhost:8069
# Opcional: debe coincidir con el parámetro "api_key" de NeaHomes > Configuración > Parámetros
ODOO_API_KEY=
# Clave para firmar el captcha propio (cualquier texto largo y aleatorio). Si falta, se usa ODOO_API_KEY.
CAPTCHA_SECRET=
